+fun resolveNodeExecutable(): String {
+    val nodeFromProp = project.findProperty("NODE_BINARY") as? String
+    if (!nodeFromProp.isNullOrBlank() && File(nodeFromProp).canExecute()) {
+        return nodeFromProp
+    }
+    val envNode = System.getenv("NODE_BINARY")
+    if (!envNode.isNullOrBlank() && File(envNode).canExecute()) {
+        return envNode
+    }
+    val commonPaths = listOf(
+        "/opt/homebrew/bin/node",
+        "/usr/local/bin/node",
+        "/usr/bin/node"
+    )
+    for (path in commonPaths) {
+        val file = File(path)
+        if (file.exists() && file.canExecute()) {
+            return path
+        }
+    }
+    val userHome = System.getProperty("user.home")
+    val nvmDir = File("$userHome/.nvm/versions/node")
+    if (nvmDir.exists() && nvmDir.isDirectory) {
+        val found = nvmDir.walkTopDown().firstOrNull { it.isFile && it.name == "node" && it.canExecute() }
+        if (found != null) {
+            return found.absolutePath
+        }
+    }
+    return "node"
+}
+
+val nodeExecutable = resolveNodeExecutable()
