<?xml version="1.0" encoding="utf-8"?>
<!--
  Medium Widget Info: 4x2 wide
  - Full phone width (4 cells), system default height (2 cells)
  - resizeMode="none" → user cannot resize; stays medium always
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="110dp"
    android:resizeMode="none"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    android:initialLayout="@layout/widget_medium"
    android:description="@string/jap_widget_description" />
