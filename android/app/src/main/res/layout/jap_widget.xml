<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Lotus Icon & Om Symbol -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_lotus"
            android:layout_width="22dp"
            android:layout_height="17dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Lotus"
            android:src="@drawable/ic_lotus" />

        <TextView
            android:id="@+id/tv_om"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:fontFamily="serif"
            android:text="ॐ"
            android:textColor="#A87E4B"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Center: Mala Bead Ring with Radha image inside -->
    <RelativeLayout
        android:id="@+id/ring_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:gravity="center">

        <ImageView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:contentDescription="Radha Mala"
            android:scaleType="fitCenter" />
    </RelativeLayout>

    <!-- Bottom: Spiritual Tap to Chant Pill Button -->
    <LinearLayout
        android:id="@+id/pill"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/widget_pill_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Tap"
            android:src="@drawable/ic_hand_tap" />

        <TextView
            android:id="@+id/tv_tap_chant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="जप के लिए टैप करें"
            android:textColor="#543725"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
