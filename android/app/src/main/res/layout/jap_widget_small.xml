<?xml version="1.0" encoding="utf-8"?>
<!-- Small/Square widget: fully proportional layout — no fixed dp heights except icons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Top Row: Lotus Icon & Om Symbol — fixed header height, proportional to avoid clipping -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.13"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_lotus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="Lotus"
            android:scaleType="fitStart"
            android:src="@drawable/ic_lotus" />

        <TextView
            android:id="@+id/tv_om"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="ॐ"
            android:textColor="#A87E4B"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center: Mala Bead Ring — takes all remaining space -->
    <RelativeLayout
        android:id="@+id/ring_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.75"
        android:gravity="center">

        <ImageView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:contentDescription="Radha Mala"
            android:scaleType="fitCenter" />
    </RelativeLayout>

    <!-- Bottom: Tap to Chant Pill — proportional height -->
    <LinearLayout
        android:id="@+id/pill"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.12"
        android:background="@drawable/widget_pill_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.08"
            android:adjustViewBounds="true"
            android:contentDescription="Tap"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hand_tap" />

        <TextView
            android:id="@+id/tv_tap_chant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="जप के लिए टैप करें"
            android:textColor="#543725"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
