<?xml version="1.0" encoding="utf-8"?>
<!-- Wide widget: fully proportional layout — mala ring left, stats right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- Top Row: Lotus Icon & Om Symbol -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.13"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_lotus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="Lotus"
            android:scaleType="fitStart"
            android:src="@drawable/ic_lotus" />

        <TextView
            android:id="@+id/tv_om"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="ॐ"
            android:textColor="#A87E4B"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Row: Left Mala Ring + Right Stats+Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.87"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Mala Ring — square, takes 40% width -->
        <RelativeLayout
            android:id="@+id/ring_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.40"
            android:gravity="center">

            <ImageView
                android:id="@+id/ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:contentDescription="Radha Mala"
                android:scaleType="fitCenter" />
        </RelativeLayout>

        <!-- Right: Stats + Pill — takes 60% width -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="0.60"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Stats Row: Count | Mala -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.75"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Column 1: Today Count -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_today_count_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:text="आज कुल\nजाप"
                        android:textColor="#A87E4B"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_stat_mala"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="3dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="Mala"
                            android:scaleType="fitCenter"
                            android:src="@drawable/mala_icon" />

                        <TextView
                            android:id="@+id/tv_today_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:singleLine="true"
                            android:text="0"
                            android:textColor="#A87E4B"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Vertical Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="#D6BE9B" />

                <!-- Column 2: Today Mala -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_today_mala_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:text="आज कुल\nमाला"
                        android:textColor="#A87E4B"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_stat_flame"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="3dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="Streak"
                            android:scaleType="fitCenter"
                            android:src="@drawable/flame_icon" />

                        <TextView
                            android:id="@+id/tv_today_mala"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:singleLine="true"
                            android:text="0"
                            android:textColor="#A87E4B"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Pill Button — 25% of right column height -->
            <LinearLayout
                android:id="@+id/pill"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.25"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_pill_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.08"
                    android:adjustViewBounds="true"
                    android:contentDescription="Tap"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_hand_tap" />

                <TextView
                    android:id="@+id/tv_tap_chant"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="जप के लिए टैप करें"
                    android:textColor="#543725"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
