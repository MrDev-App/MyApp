<?xml version="1.0" encoding="utf-8"?>
<!--
  SMALL WIDGET (2x2 square)
  - Full width, square shape enforced by appwidget-provider
  - All rows sized proportionally via layout_weight (no fixed heights)
  - Header 13% | Ring 75% | Pill 12%
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Header: Lotus (left) + ॐ (right) — 13% of height -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.13"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_lotus"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Lotus"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lotus" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_om"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="ॐ"
            android:textColor="#A87E4B"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mala Ring — 75% of height, full width, square image centered -->
    <RelativeLayout
        android:id="@+id/ring_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.75"
        android:gravity="center">

        <ImageView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:contentDescription="Radha Mala"
            android:scaleType="fitCenter" />
    </RelativeLayout>

    <!-- Tap to Chant Pill — 12% of height -->
    <LinearLayout
        android:id="@+id/pill"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.12"
        android:background="@drawable/widget_pill_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="5dp"
            android:adjustViewBounds="true"
            android:contentDescription="Tap"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hand_tap" />

        <TextView
            android:id="@+id/tv_tap_chant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="जप के लिए टैप करें"
            android:textColor="#543725"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
