<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:paddingLeft="10dp"
    android:paddingTop="8dp"
    android:paddingRight="10dp"
    android:paddingBottom="8dp">

    <!-- Top Row: Lotus (left) and Om (right) -->
    <LinearLayout
        android:id="@+id/widget_small_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="15dp"
            android:contentDescription="Lotus"
            android:scaleType="fitStart"
            android:src="@drawable/ic_lotus" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ॐ"
            android:textColor="#873719"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Pill Button: Tap to Chant -->
    <LinearLayout
        android:id="@+id/widget_small_pill"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/widget_pill_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:contentDescription="Hand Tap"
            android:src="@drawable/ic_hand_tap" />

        <TextView
            android:id="@+id/widget_small_pill_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:includeFontPadding="false"
            android:text="जप के लिए टैप करें"
            android:textColor="#873719"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center: Mala Ring with Radha -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/widget_small_pill"
        android:layout_below="@id/widget_small_header"
        android:layout_centerInParent="true"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp">

        <ImageView
            android:id="@+id/widget_small_mala_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="Mala Bead Ring"
            android:scaleType="fitCenter" />
    </FrameLayout>

</RelativeLayout>
